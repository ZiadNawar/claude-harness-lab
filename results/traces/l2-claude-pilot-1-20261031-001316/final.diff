+function floorDivide(numerator, denominator) {
+  const quotient = numerator / denominator;
+  return numerator % denominator < 0n ? quotient - 1n : quotient;
+}
+
+/**
+ * Splits a rate group's tax between its lines. Each line starts at its exact
+ * tax rounded down; the units still missing from the group's tax go to the
+ * lines with the largest fractions, earlier lines first on a tie. So the line
+ * taxes add up to the group tax, and each is within one minor unit of
+ * `net * rate`.
+ */
+function splitGroupTax(members, rateBps, groupTax) {
+  const divisor = BigInt(BASIS_POINTS);
+  const shares = members.map(({ line }) => {
+    const exact = BigInt(line.net) * BigInt(rateBps);
+    const whole = floorDivide(exact, divisor);
+    return { whole, fraction: exact - whole * divisor };
+  });
+  let missing = BigInt(groupTax) - shares.reduce((sum, share) => sum + share.whole, 0n);
+  const order = shares
+    .map((share, index) => ({ share, index }))
+    .sort((a, b) => {
+      if (a.share.fraction !== b.share.fraction) return a.share.fraction > b.share.fraction ? -1 : 1;
+      return a.index - b.index;
+    });
+  for (const { share } of order) {
+    if (missing <= 0n) break;
+    share.whole += 1n;
+    missing -= 1n;
+  }
+  return shares.map((share) => Number(share.whole));
+}
+
 /** Adds `tax` and `gross` to each discounted line. */
 export function applyTax(lines) {
-  return lines.map((line) => {
-    const tax = taxForAmount(line.net, line.taxRateBps);
-    return { ...line, tax, gross: line.net + tax };
-  });
+  const taxes = new Array(lines.length);
+  for (const [rateBps, members] of groupByRate(lines)) {
+    const groupTax = taxForAmount(
+      members.reduce((sum, { line }) => sum + line.net, 0),
+      rateBps,
+    );
+    splitGroupTax(members, rateBps, groupTax).forEach((tax, i) => {
+      taxes[members[i].position] = tax;
+    });
+  }
+  return lines.map((line, position) => ({
+    ...line,
+    tax: taxes[position],
+    gross: line.net + taxes[position],
+  }));
 }
 
