index 4438314..21c553c 100644
--- a/src/invoicing/allocation.mjs
+++ b/src/invoicing/allocation.mjs
@@ -28,7 +28,25 @@ export function allocate(amount, weights) {
     throw new RangeError('allocate needs at least one positive weight');
   }
 
-  const parts = weights.map((weight) => Math.round((amount * weight) / totalWeight));
-  parts[parts.length - 1] += amount - sumAmounts(parts);
-  return parts;
+  // Largest remainder method on exact integers: every part is its share rounded
+  // down or up, the spare units go to the biggest fractions (earlier lines win a
+  // tie), and a zero weight never has a fraction. The sign is applied last so a
+  // negative amount splits as the mirror of the positive one.
+  const magnitude = BigInt(Math.abs(amount));
+  const total = BigInt(totalWeight);
+  const shares = weights.map((weight) => {
+    const product = magnitude * BigInt(weight);
+    return { part: product / total, fraction: product % total };
+  });
+  let spare = Number(magnitude - shares.reduce((sum, { part }) => sum + part, 0n));
+  const byFraction = shares
+    .map((share, position) => ({ ...share, position }))
+    .sort((a, b) => (a.fraction === b.fraction ? a.position - b.position : a.fraction < b.fraction ? 1 : -1));
+  for (const { position } of byFraction) {
+    if (spare === 0) break;
+    shares[position].part += 1n;
+    spare -= 1;
+  }
+  const sign = amount < 0 ? -1 : 1;
+  return shares.map(({ part }) => (part === 0n ? 0 : sign * Number(part)));
 }
